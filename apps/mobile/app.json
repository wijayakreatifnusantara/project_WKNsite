{
  "expo": {
    "name": "WKN Mobile",
    "slug": "wkn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wkn-logo-square.jpg",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wijayakn.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/images/wkn-logo-square.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "WKN Mobile membutuhkan kamera untuk absensi."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WKN Mobile membutuhkan lokasi untuk validasi absensi."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wkn-logo-square.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbd3d71d-a69c-4188-ba8f-a775202b26b5"
      }
    },
    "owner": "wknproject"
  }
}
